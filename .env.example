# ==============================================================================
# HERMES AGENT DOCKER ENVIRONMENT TEMPLATE
# ==============================================================================
# Salin berkas ini ke .env dan isi dengan kunci/token Anda:
# cp .env.example .env

# LLM Provider Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Telegram Gateway (Bot Mode)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_id_here

# WhatsApp Gateway (jika diaktifkan)
# WHATSAPP_ENABLED=false

# Dashboard & API Security
HERMES_DASHBOARD=1
HERMES_DASHBOARD_PORT=9119
API_SERVER_ENABLED=true
API_SERVER_PORT=8642
API_SERVER_KEY=hermes_secret_api_key_2026
